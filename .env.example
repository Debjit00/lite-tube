# LiteTube Cloud MySQL Configuration
# Copy this file to .env and fill in your cloud MySQL credentials.

# Option 1: Single connection URL (supports mysql:// or mysql+pymysql://)
# Example (Aiven / TiDB / Railway / PlanetScale):
# DATABASE_URL=mysql://avnadmin:YOUR_PASSWORD@your-db-host.aivencloud.com:12345/defaultdb?ssl-mode=REQUIRED

# Option 2: Individual MySQL connection fields (used if DATABASE_URL is empty)
MYSQL_HOST=your-mysql-host.example.com
MYSQL_PORT=3306
MYSQL_USER=your_username
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=litetube

# TLS/SSL settings (recommended for cloud-hosted MySQL)
MYSQL_SSL=true
# Optional path to a provider CA certificate (.pem)
# MYSQL_SSL_CA=certs/ca.pem
# Set to false only if your provider uses a self-signed certificate without a CA file
# MYSQL_SSL_VERIFY=true

# Optional app signing secret (auto-generated in data/.secret_key if omitted)
# LITETUBE_SECRET_KEY=change-me-to-a-long-random-string
